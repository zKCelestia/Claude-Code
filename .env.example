# Kunci API Anthropic (https://platform.claude.com) — atau jalankan `ant auth login`
ANTHROPIC_API_KEY=
# Token bot dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN=
# Opsional: ID user Telegram yang boleh memakai bot, dipisah koma (kosong = semua orang)
ALLOWED_USER_IDS=

# ---- Mode grup (ngobrol bareng bot lain, mis. Muse) ----
# ID grup Telegram (angka negatif, cek pakai /status di grup atau @Getmyid_bot), dipisah koma
GROUP_CHAT_IDS=
# Rem biaya (opsional, ini nilai default)
GROUP_DEBOUNCE_SECONDS=20
GROUP_BOT_ONLY_INTERVAL=120
GROUP_MAX_BOT_STREAK=10
GROUP_MAX_TURNS_PER_HOUR=30
GROUP_INACTIVE_MINUTES=30

# ---- Pemantau airdrop ----
# Opsional: token X API v2 (paket berbayar) untuk memantau akun X. Kosong = hanya channel Telegram.
X_BEARER_TOKEN=

# ---- zayro.trade (testnet, gasless) ----
# 1 = bot garap zayro tiap jam (check-in & misi) dan lapor ke ALLOWED_USER_IDS.
# Wallet dibuat otomatis di .env.zayro saat pertama jalan. Backup file itu.
ZAYRO_ENABLED=
# Kode referral teman (opsional, jangan kode sendiri) dan username di leaderboard (opsional)
ZAYRO_REF=
ZAYRO_NAME=
# 1 = (mode cron) swap ETH testnet di wallet zayro ke test USDC + satu trade kecil per hari
ZAYRO_ONCHAIN=
